slam_toolbox:
  ros__parameters:
    use_sim_time: false
    use_map_saver: true
    map_frame: map
    odom_frame: odom
    base_frame: base_link
    scan_topic: /scan
    mode: mapping

    #Solver Settings
    solver_plugin: solver_plugins::CeresSolver
    # Add/Update these for Ceres
    ceres_linear_solver_type: SPARSE_NORMAL_CHOLESKY
    ceres_preconditioner_type: SCHUR_JACOBI
    ceres_trust_strategy_type: LEVENBERG_MARQUARDT
    ceres_dogleg_type: TRADITIONAL_DOGLEG
    ceres_loss_function_type: None

    #Essential Tuning for Jitter
    resolution: 0.05                     #5cm per pixel
    max_laser_range: 10.0                #Clip C1 range to keep data clean
    minimum_time_interval: 0.2           #Process scans every 200ms (reduces noise)
    transform_timeout: 0.2               #Wait for WiFi latency
    tf_buffer_duration: 30.0
    debug_logging: false
    throttle_scans: 1
    transform_publish_period: 0.02 # 50Hz for smooth TF
    map_update_interval: 2.0      # Slower updates = less "pulsing" jitter
    stack_size_to_use: 40000000

    #Scan Matching(The "Wall Sharperner")
    fine_search_res: 0.01                #Higher precision for alignment
    max_condition_number: 0.2            #Be stricter about accepting bad matches
    max_iterations: 40
    use_response_expansion: true

    #Motion Jitter Filter
    minimum_travel_distance: 0.1         #Dont update map unless moved 10cm
    minimum_travel_heading: 0.1          #Dont update map unless turned ~5.7 degrees

    # Correlation Parameters - This is where jitter is fought
    correlation_search_space_dimension: 0.4
    correlation_search_space_resolution: 0.01
    correlation_search_space_smear_deviation: 0.05

    # Loop Closure Parameters
    loop_search_space_dimension: 8.0
    loop_search_space_resolution: 0.05
    loop_search_space_smear_deviation: 0.03
    distance_variance_penalty: 0.5
    angle_variance_penalty: 0.8        # Increase if map "rotates" incorrectly
