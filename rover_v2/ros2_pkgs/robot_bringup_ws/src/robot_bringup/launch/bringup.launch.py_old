from launch import LaunchDescription
from launch.actions import ExecuteProcess, IncludeLaunchDescription, TimerAction
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import Node

import os


def generate_launch_description():

    lidar_launch = os.path.expanduser(
        '~/Desktop/slam/install/sllidar_ros2/share/sllidar_ros2/launch/sllidar_c1_launch.py'
    )

    imu = ExecuteProcess(
        cmd=[
            '/home/nagha/Desktop/mpu9250/imu_env/bin/python3',
            '/home/nagha/Desktop/mpu9250/ros_ws/src/imu_mpu9250/imu_mpu9250/imu_node.py'
        ],
        output='screen'
    )

    wheel = Node(
        package='wheel_odometry',
        executable='wheel_odom',
        name='wheel_odom',
        output='screen'
    )

    lidar = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(lidar_launch)
    )

    imu_tf = Node(
        package='tf2_ros',
        executable='static_transform_publisher',
        arguments=['0', '0', '0.05', '0', '0', '0', 'base_link', 'imu_link']
    )

    laser_tf = Node(
        package='tf2_ros',
        executable='static_transform_publisher',
        arguments=['0.18', '0', '0.12', '0', '0', '0', 'base_link', 'laser']
    )

    ekf = Node(
        package='robot_localization',
        executable='ekf_node',
        name='ekf_filter_node',
        output='screen',
        parameters=[
            '/home/nagha/Desktop/robot_bringup_ws/src/robot_bringup/config/ekf.yaml',
            {'use_sim_time': False}
        ]
    )

    slam = Node(
        package='slam_toolbox',
        executable='async_slam_toolbox_node',
        name='slam_toolbox',
        output='screen',
        parameters=[
            '/home/nagha/Desktop/robot_bringup_ws/src/robot_bringup/config/slam.yaml',
            {'use_sim_time': False}
        ]
    )

    # delay slam startup until odom/tf exist
    delayed_slam = TimerAction(
        period=3.0,
        actions=[slam]
    )

    return LaunchDescription([
        imu,
        wheel,
        lidar,
        imu_tf,
        laser_tf,
        ekf,
        delayed_slam
        #slam
    ])
